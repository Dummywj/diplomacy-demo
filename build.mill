package build

import mill.*, scalalib.*

object cde extends ScalaModule {
  def scalaVersion = "2.13.16"
  override def sources = Task.Sources(moduleDir / "cde" / "src")
}

object diplomacy extends ScalaModule {
  def scalaVersion = "2.13.16"
  override def sources = Task.Sources(moduleDir / "diplomacy" / "src")

  def moduleDeps = Seq(cde)

  def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:6.7.0"
  )

  def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:6.7.0"
  )
}

object demo extends ScalaModule {
  def scalaVersion = "2.13.16"

  def moduleDeps = Seq(cde, diplomacy)

  def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:6.7.0",
    mvn"com.lihaoyi::sourcecode:0.3.1"
  )

  def scalacPluginMvnDeps = Seq(
    mvn"org.chipsalliance:::chisel-plugin:6.7.0"
  )
}
